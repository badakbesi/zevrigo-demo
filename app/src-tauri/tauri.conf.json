{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zevrigo Node",
  "version": "0.1.0",
  "identifier": "com.zevrigo.node",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Zevrigo Node",
        "width": 960,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Zevrigo",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "PRIVASI-DAN-LISENSI.txt",
    "homepage": "https://github.com/badakbesi/zevrigo-demo",
    "copyright": "Pembuat Zevrigo, MIT OR Apache-2.0",
    "shortDescription": "Zevrigo Node: node dan penambang jaringan demo regtest",
    "externalBin": [
      "binaries/zevrigo-node",
      "binaries/zevrigo-miner"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
