# ~/zevrigo-regtest/susunan/.env di setiap VPS resmi Zevrigo (TSK-M76, DEC-47). Disalin ke VPS sekali lalu disesuaikan; bukan rahasia (token
# tunnel ada di ~/zevrigo-regtest/rahasia/tunnel.env, izin 600). Dengan berkas ini perintah di setiap VPS sama: cd ~/zevrigo-regtest/susunan && docker compose up -d --no-build
COMPOSE_FILE=compose.yaml:compose.publik.yaml
# Susunan VPS resmi = profile demo
COMPOSE_PROFILES=demo
# Nama VPS ini untuk ~/zevrigo-regtest/susunan/VERSI dan scripts/vps-resmi-periksa.sh (huruf kecil, angka, tanda minus): vps-demo, ...
ZVRG_NAMA_VPS=vps-demo
# Nama host seed P2P VPS ini di tunnel-nya (route HTTP localhost:28803); diumumkan seed ke rekan (--p2p-publik)
ZVRG_HOST_SEED=demo-seed-p2p.zevrigo.online
# Penambang cadangan menambang satu blok bila tinggi chain diam sekian detik (PC mati); berbeda per VPS (300, 420, 540, ...)
# agar dua VPS tidak menambang bersamaan
ZVRG_DIAM=300
